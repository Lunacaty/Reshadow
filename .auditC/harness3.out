=== 7张 ctr:X 卡的编译产物结构 ===
-- 10131320 暴风破
   event=OnSpellboost ActiveZone=Board body=1
     ModifyCounter X Op=Add Delta=1 Target=null(玩家级)
   event=OnPlay ActiveZone=Board body=2
     select opponent:board<Follower> Choose(1)
     deal ctr:X damage to $selected
   event=PassiveAura ActiveZone=Board body=1
     ModifyCounter X Op=Set Delta=2 Target=null(玩家级)
-- 10132130 玛纳利亚的学生·威廉
   event=OnSpellboost ActiveZone=Board body=1
     ModifyCounter X Op=Add Delta=1 Target=null(玩家级)
   event=OnPlay ActiveZone=Board body=1
     deal ctr:X damage to opponent:board<Follower> All
   event=OnEvolve ActiveZone=Board body=1
     ModifyCounter spellboost Op=Add Delta=2 Target=self:hand All
   event=PassiveAura ActiveZone=Board body=1
     ModifyCounter X Op=Set Delta=0 Target=null(玩家级)
-- 10133310 做作业啦！
   event=OnSpellboost ActiveZone=Board body=2
     ModifyCounter X Op=Add Delta=1 Target=null(玩家级)
     Conditional ctr:X >= 5
       then transform $self into #90033310
   event=OnPlay ActiveZone=Board body=1
     draw 2
   event=PassiveAura ActiveZone=Board body=1
     ModifyCounter X Op=Set Delta=0 Target=null(玩家级)
-- 10232310 混沌赤焰
   event=OnSpellboost ActiveZone=Board body=1
     ModifyCounter X Op=Add Delta=1 Target=null(玩家级)
   event=OnPlay ActiveZone=Board body=1
     deal ctr:X damage to opponent:board<Follower> All split
   event=PassiveAura ActiveZone=Board body=1
     ModifyCounter X Op=Set Delta=0 Target=null(玩家级)
-- 10831310 暴风破
   event=OnSpellboost ActiveZone=Board body=1
     ModifyCounter X Op=Add Delta=1 Target=null(玩家级)
   event=OnPlay ActiveZone=Board body=2
     select opponent:board<Follower> Choose(1)
     deal ctr:X damage to $selected
   event=PassiveAura ActiveZone=Board body=1
     ModifyCounter X Op=Set Delta=2 Target=null(玩家级)
-- 10833310 钢铁的小憩
   event=OnSpellboost ActiveZone=Board body=1
     ModifyCounter X Op=Add Delta=1 Target=null(玩家级)
   event=OnPlay ActiveZone=Board body=2
     draw 2
     Conditional ctr:X >= 5
       then restore 2 life to self:leader
       then recover_pp 2
   event=PassiveAura ActiveZone=Board body=1
     ModifyCounter X Op=Set Delta=0 Target=null(玩家级)
-- 10834110 恩爱的大地·坦忒拉&拉缇卡
   event=OnSpellboost ActiveZone=Board body=1
     ModifyCounter X Op=Add Delta=1 Target=null(玩家级)
   event=OnPlay ActiveZone=Board body=2
     Conditional ctr:X >= 10
       then add_to_hand 1 #90034340
     Conditional ctr:X >= 20
       then add_to_hand 1 #90034350
   event=PassiveAura ActiveZone=Board body=1
     ModifyCounter X Op=Set Delta=0 Target=null(玩家级)
=== ACP 打印中 Where 的 Of 主语（where has ward 回环） ===
  原始: select self:board<Follower> Choose(1) where has ward
  ACP : select self:board<Follower> Choose(1) where has ward
  CCP : 选择我方战场的1个拥有【守护】的随从，
  二次解析 errors=0 | 
  where原 = And[HasKind(Follower, Of=$self),HasKeyword(ward, Of=$item)]
  where回 = And[HasKind(Follower, Of=$self),HasKeyword(ward, Of=$item)]
